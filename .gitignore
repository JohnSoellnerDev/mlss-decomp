# The game itself never goes into this repository: bring your own ROM (see README).
*.gba
*.sav
*.bin

# The original assembly is generated from the ROM by configure.py: never commit it
/asm/*
!/asm/macros.inc

# Build output and generated files
build/
build.ninja
.ninja_*
objdiff.json
report.json

# Toolchain installed by tools/setup.sh
tools/agbcc/
tools/objdiff-cli
.venv/

__pycache__/
*.pyc
.claude/
tools/binutils/
tools/bin/
tools/pylib/
